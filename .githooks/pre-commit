#!/bin/sh
# Before a commit that changes wordlist/words.out: trim spaces, drop blank lines
# and duplicates, and sort the words (ignoring case, as the site does).
# Turn on once per checkout with:  git config core.hooksPath .githooks
git diff --cached --name-only | grep -qx 'wordlist/words.out' || exit 0

python3 - <<'EOF'
from pathlib import Path
path = Path('wordlist/words.out')
lines = path.read_text(encoding='utf-8').splitlines()
words = sorted({w.strip() for w in lines if w.strip()}, key=lambda w: (w.lower(), w))
text = '\n'.join(words) + '\n'
if text != path.read_text(encoding='utf-8'):
    path.write_text(text, encoding='utf-8')
    print(f'words.out: sorted, {len(lines) - len(words)} blank or duplicate lines removed')
EOF
git add wordlist/words.out
