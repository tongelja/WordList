[Unit]
Description=WordList dictionary web app
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/WordList/wordlist
ExecStart=/home/pi/.local/bin/uv run --no-sync gunicorn --workers 2 --bind 0.0.0.0:5055 --access-logfile - wordApp:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
